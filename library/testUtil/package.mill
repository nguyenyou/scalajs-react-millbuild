package build.library.testUtil

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryBaseModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.testUtil)

  def moduleDeps = super.moduleDeps ++
    Seq(
      build.library.facadeTest,
      build.library.testUtilMacros,
      build.library.extra
    )

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilDummyDefaults)

  def artifactName = "test"

}
