package build.library.callback

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import mill.scalanativelib.*
import millbuild.*

object `package` extends LibraryPublishModule {

  def moduleDeps = super.moduleDeps ++ Seq(build.library.util)

  def compileModuleDeps =
    super.compileModuleDeps ++ Seq(build.library.utilFallbacks)

  def artifactName = "callback"

  object test extends ScalaJSTests with SbtTests with TestModule.Utest {

    def mvnDeps = super.mvnDeps() ++
      Seq(Deps.utest, Deps.testUtil, Deps.catsCore)

    def compileModuleDeps = super.compileModuleDeps ++
      Seq(build.library.utilFallbacks)

    def runModuleDeps = super.runModuleDeps ++ Seq(build.library.utilFallbacks)

    def testParallelism = false

    def testSandboxWorkingDir = false

  }

}
