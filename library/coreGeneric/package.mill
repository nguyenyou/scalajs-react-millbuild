package build.coreGeneric

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends Cross[CoreGenericModule]("2.13.17", "3.3.4")
trait CoreGenericModule extends LibraryPublishModule {

  def mvnDeps = super.mvnDeps() ++
    Seq(Deps.compileTime, Deps.types, Deps.sourcecode) ++
    (scalaVersion() match {
      case "2.13.17" => Seq(Deps.scalaReflect)
      case _         => Nil
    })

  def compileMvnDeps = super.compileMvnDeps() ++
    (scalaVersion() match {
      case "2.13.17" => Seq(Deps.scalaCompiler)
      case _         => Nil
    })

  def moduleDeps = super.moduleDeps ++ Seq(build.facadeMain(), build.util())

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.utilDummyDefaults())

  def artifactName = "core-generic"

  def scalacOptions = super.scalacOptions() ++
    (scalaVersion() match {
      case "2.13.17" => Seq("-language:experimental.macros")
      case _         => Nil
    })

  def pomSettings = PomSettings(
    "coreGeneric",
    "com.github.japgolly.scalajs-react",
    "https://github.com/japgolly/scalajs-react",
    Seq(License(
      "",
      "Apache-2.0",
      "http://opensource.org/licenses/Apache-2.0",
      false,
      false,
      "repo"
    )),
    VersionControl(
      Some("https://github.com/japgolly/scalajs-react"),
      Some("scm:git:https://github.com/japgolly/scalajs-react.git"),
      Some("scm:git:git@github.com:japgolly/scalajs-react.git"),
      None
    ),
    Seq(Developer(
      "japgolly",
      "David Barri",
      "https://japgolly.github.io/japgolly/",
      None,
      None
    ))
  )

}
