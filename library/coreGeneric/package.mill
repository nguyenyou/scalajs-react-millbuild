package build.library.coreGeneric

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryBaseModule {

  def mvnDeps = super.mvnDeps() ++
    Seq(Deps.compileTime, Deps.types, Deps.sourcecode)

  def moduleDeps =
    super.moduleDeps ++ Seq(build.library.facadeMain, build.library.util)

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilDummyDefaults)

  def artifactName = "core-generic"

}
