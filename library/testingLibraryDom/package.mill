package build.testingLibraryDom

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends Cross[TestingLibraryDomModule]("2.13.17", "3.3.4")
trait TestingLibraryDomModule extends LibraryPublishModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.scalajsDom)

  def moduleDeps = super.moduleDeps ++ Seq(build.testUtil())

  def artifactName = "testing_library-dom"

  def pomSettings = PomSettings(
    "testingLibraryDom",
    "com.github.japgolly.scalajs-react",
    "https://github.com/japgolly/scalajs-react",
    Seq(License(
      "",
      "Apache-2.0",
      "http://opensource.org/licenses/Apache-2.0",
      false,
      false,
      "repo"
    )),
    VersionControl(
      Some("https://github.com/japgolly/scalajs-react"),
      Some("scm:git:https://github.com/japgolly/scalajs-react.git"),
      Some("scm:git:git@github.com:japgolly/scalajs-react.git"),
      None
    ),
    Seq(Developer(
      "japgolly",
      "David Barri",
      "https://japgolly.github.io/japgolly/",
      None,
      None
    ))
  )

}
