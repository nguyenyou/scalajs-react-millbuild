package build.ghpages

import mill.*
import mill.javalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends Cross[GhpagesModule]("2.13.17", "3.3.4")
trait GhpagesModule extends ScalaJSModule with LibraryBaseModule {

  def scalaJSVersion = "1.20.1"

  // Resolve conflicting inherited members
  override def scalacPluginMvnDeps: T[Seq[Dep]] =
    super[LibraryBaseModule].scalacPluginMvnDeps()

  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.fastTextEncoding,
    Deps.react,
    Deps.reactDom,
    Deps.reactDom,
    Deps.reactDom
  )

  def moduleDeps = super.moduleDeps ++ Seq(
    build.coreExtCatsEffect(),
    build.coreBundleCallback(),
    build.extra(),
    build.extraExtMonocle3(),
    build.ghpagesMacros()
  )

  def artifactName = "ghpages"

  // ghpages doesn't have proper Scala 3 source support yet, disable for Scala 3
  override def sources: T[Seq[PathRef]] = Task {
    scalaVersion() match {
      case v if v.startsWith("2") => super.sources()
      case _                      => Seq.empty[PathRef]
    }
  }

}
