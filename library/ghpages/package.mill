package build.ghpages

import mill.*
import mill.javalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends ScalaJSModule with LibraryBaseModule {

  def scalaJSVersion = "1.20.1"

  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.fastTextEncoding,
    Deps.react,
    Deps.reactDom,
    Deps.reactDom,
    Deps.reactDom
  )

  def moduleDeps = super.moduleDeps ++ Seq(
    build.coreExtCatsEffect,
    build.coreBundleCallback,
    build.extra,
    build.extraExtMonocle3,
    build.ghpagesMacros
  )

  def artifactName = "ghpages"

  // ghpages doesn't have proper Scala 3 source support yet
  override def sources: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

}
