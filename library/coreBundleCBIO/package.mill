package build.library.coreBundleCBIO

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryBaseModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.compileTime)

  def moduleDeps = super.moduleDeps ++
    Seq(
      build.library.callback,
      build.library.coreExtCatsEffect,
      build.library.utilFallbacks
    )

  def artifactName = "core-bundle-cb_io"

}
