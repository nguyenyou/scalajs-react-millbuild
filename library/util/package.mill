package build.util

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import mill.scalanativelib.*
import millbuild.*

object `package` extends Cross[UtilModule]("2.13.17", "3.3.4")
trait UtilModule extends LibraryPublishModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.scalajsDom)

  def compileModuleDeps = super.compileModuleDeps ++ Seq(build.utilFallbacks())

  def artifactName = "util"

  def pomSettings = PomSettings(
    "util",
    "com.github.japgolly.scalajs-react",
    "https://github.com/japgolly/scalajs-react",
    Seq(License(
      "",
      "Apache-2.0",
      "http://opensource.org/licenses/Apache-2.0",
      false,
      false,
      "repo"
    )),
    VersionControl(
      Some("https://github.com/japgolly/scalajs-react"),
      Some("scm:git:https://github.com/japgolly/scalajs-react.git"),
      Some("scm:git:git@github.com:japgolly/scalajs-react.git"),
      None
    ),
    Seq(Developer(
      "japgolly",
      "David Barri",
      "https://japgolly.github.io/japgolly/",
      None,
      None
    ))
  )

  object test extends ScalaJSTests with CrossSbtTests with TestModule.Utest {

    def mvnDeps = super.mvnDeps() ++ Seq(Deps.utest, Deps.testUtil)

    def compileModuleDeps = super.compileModuleDeps ++
      Seq(build.utilFallbacks())

    def runModuleDeps = super.runModuleDeps ++ Seq(build.utilFallbacks())

    def testParallelism = false

    def testSandboxWorkingDir = false

  }

}
