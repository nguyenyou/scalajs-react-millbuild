package build.library.scalafixRules

import mill.*
import mill.javalib.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryBaseModule {

  def artifactName = "scalafix"

  // Scalafix doesn't support Scala 3, so we disable compilation
  override def sources: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

}
