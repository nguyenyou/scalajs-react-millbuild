package build.scalafixRules

import mill.*
import mill.javalib.*
import mill.scalalib.*
import millbuild.*

object `package` extends Cross[ScalafixRulesModule]("3.3.4")
trait ScalafixRulesModule extends LibraryBaseModule {

  def artifactName = "scalafix"

  // Scalafix doesn't support Scala 3, so we disable compilation
  override def sources: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

}
