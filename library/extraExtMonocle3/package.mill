package build.library.extraExtMonocle3

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryPublishModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.monocleCore)

  def moduleDeps =
    super.moduleDeps ++ Seq(build.library.extra, build.library.coreExtCats)

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilDummyDefaults)

  def artifactName = "extra-ext-monocle3"

}
