package build.library.testUtilMacros

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryPublishModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.compileTime)

  def moduleDeps = super.moduleDeps ++ Seq(build.library.coreGeneric)

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilDummyDefaults)

  def artifactName = "test-macros"

}
