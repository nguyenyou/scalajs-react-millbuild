package build.library.coreExtCatsEffect

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryBaseModule {

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.catsEffect)

  def moduleDeps = super.moduleDeps ++
    Seq(build.library.coreExtCats, build.library.utilCatsEffect)

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilFallbacks, build.library.utilDummyDefaults)

  def artifactName = "core-ext-cats_effect"

}
