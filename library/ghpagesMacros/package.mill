package build.ghpagesMacros

import mill.*
import mill.javalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends Cross[GhpagesMacrosModule]("2.13.17", "3.3.4")
trait GhpagesMacrosModule extends ScalaJSModule with LibraryBaseModule {

  def scalaJSVersion = "1.20.1"

  // Resolve conflicting inherited members
  override def scalacPluginMvnDeps: T[Seq[Dep]] =
    super[LibraryBaseModule].scalacPluginMvnDeps()

  def mvnDeps = super.mvnDeps() ++ Seq(Deps.compileTime, Deps.sourcecode) ++
    (scalaVersion() match {
      case "2.13.17" => Seq(Deps.scalaReflect)
      case _         => Nil
    })

  def compileMvnDeps = super.compileMvnDeps() ++
    (scalaVersion() match {
      case "2.13.17" => Seq(Deps.scalaCompiler)
      case _         => Nil
    })

  def artifactName = "ghpagesmacros"

  def scalacOptions = super.scalacOptions() ++
    (scalaVersion() match {
      case "2.13.17" => Seq("-language:experimental.macros")
      case _         => Nil
    })

}
