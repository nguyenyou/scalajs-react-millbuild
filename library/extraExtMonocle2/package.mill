package build.library.extraExtMonocle2

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalalib.*
import millbuild.*

object `package` extends LibraryPublishModule {

  def moduleDeps =
    super.moduleDeps ++ Seq(build.library.extra, build.library.coreExtCats)

  def compileModuleDeps = super.compileModuleDeps ++
    Seq(build.library.utilDummyDefaults)

  def artifactName = "extra-ext-monocle2"

  // Monocle 2.x doesn't support Scala 3, so we disable compilation
  override def sources: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

  def pomSettings = PomSettings(
    "extraExtMonocle2",
    "com.github.japgolly.scalajs-react",
    "https://github.com/japgolly/scalajs-react",
    Seq(
      License(
        "",
        "Apache-2.0",
        "http://opensource.org/licenses/Apache-2.0",
        false,
        false,
        "repo"
      )
    ),
    VersionControl(
      Some("https://github.com/japgolly/scalajs-react"),
      Some("scm:git:https://github.com/japgolly/scalajs-react.git"),
      Some("scm:git:git@github.com:japgolly/scalajs-react.git"),
      None
    ),
    Seq(
      Developer(
        "japgolly",
        "David Barri",
        "https://japgolly.github.io/japgolly/",
        None,
        None
      )
    )
  )

}
